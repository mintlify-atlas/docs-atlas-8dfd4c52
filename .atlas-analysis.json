    "SchemaProducer.main(String[])",
    "DynamicProductProducer.main(String[])",
    "Consumer.main(String[])",
    "SchemaConsumer.main(String[])",
    "KafkaConnectionTest.main(String[])",
    "KafkaTopicCreator.main(String[])",
    "KafkaTopicDeleter.main(String[])",
    "AvroSchemaService.inferSchemaFromSamples(List<JsonNode>, String, String)",
    "RecordMapper.map(JsonNode, Schema)",
    "ApiFetchService.fetchProducts()",
    "PaymentEvent(String, long, String, String)",
    "PaymentAvro (Avro-generated record: customerId, amount, currency, eventType)"
  ]
