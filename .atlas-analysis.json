  "keyFeatures": [
    "String and raw JSON message production to Confluent Cloud topics",
    "Avro serialization with auto-generated POJO from .avsc schemas",
    "JSON Schema serialization using Confluent KafkaJsonSchemaSerializer",
    "Dynamic Avro schema inference from live API data (dummyjson.com/products)",
    "Confluent Schema Registry integration for schema evolution",
    "Kafka Admin API for programmatic topic creation and deletion",
    "Local Kafka support via KafkaLocalConnection (no auth)",
    "Confluent Cloud SASL_SSL/PLAIN authentication via dotenv",
    "Multi-stage Docker build producing a lean JRE Alpine runtime image",
    "Consumer group management with configurable offset reset policy"
  ],
  "publicApiSurface": [
    "KafkaConnection.getProperties()",
    "KafkaLocalConnection.getProperties()",
    "RegistryConnection.getProperties()",
    "Producer.main(String[])",
    "LocalProducer.main(String[])",
